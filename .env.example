# Kopieren nach .env und anpassen. Die .env wird NIE committet.

APP_ENV=development            # development | production
APP_URL=http://localhost:8080/  # Basis-URL, wird u.a. fuer Passwort-Reset-Links genutzt
APP_NAME="Travel Companion"

DB_DSN="mysql:host=localhost;dbname=travel;charset=utf8mb4"
DB_USER=travel
DB_PASS=secret

# Absender fuer System-Mails (Passwort-Reset). Muss zur Domain passen,
# sonst landen Mails im Spam.
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Travel Companion"

# Rolle fuer neue Registrierungen: author | visitor
# (Der allererste registrierte Benutzer wird automatisch admin.)
DEFAULT_ROLE=author

# Registrierung offen? Bei false koennen sich keine neuen Benutzer registrieren.
REGISTRATION_OPEN=true
