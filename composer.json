{
    "name": "gcprogram/travel-companion",
    "description": "Reisetagebuch & Reiseblog \u2013 mobile-first, mit KI-Unterst\u00fctzung. L\u00e4uft auf Standard-Shared-Hosting (PHP 8.4, MySQL/MariaDB).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "monolog/monolog": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8080 -t public",
        "migrate": "php bin/console.php migrate",
        "worker": "php bin/console.php jobs:work"
    }
}
